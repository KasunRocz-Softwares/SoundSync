<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": the GitHub artifact is a zip
     holding the NSIS installer and the MSI. Both are Authenticode-signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe">
      <authenticode-sign />
    </pe-file>
    <msi-file path="*.msi">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
