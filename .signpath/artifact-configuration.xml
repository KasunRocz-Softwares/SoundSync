<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": the GitHub artifact is a zip
     holding the NSIS installer and the MSI. Both are Authenticode-signed.
     Only files whose metadata names this product are accepted, so the
     certificate cannot be used to sign anything else. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="SyncSound_*_x64-setup.exe" max-matches="1" product-name="SyncSound">
      <authenticode-sign />
    </pe-file>
    <msi-file path="SyncSound_*_x64_en-US.msi" max-matches="1">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
