{
  "identifier": "default",
  "description": "Main SyncSound window: core APIs plus the SyncSound engine commands only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-audio-devices",
    "allow-get-engine-status",
    "allow-start-audio-engine",
    "allow-stop-audio-engine",
    "allow-select-capture-source",
    "allow-enable-device",
    "allow-disable-device",
    "allow-set-device-volume",
    "allow-set-device-mute",
    "allow-set-device-delay",
    "allow-set-audio-mode",
    "allow-get-sync-metrics",
    "allow-save-profile",
    "allow-load-profile",
    "allow-list-profiles",
    "allow-rebind-profile-device",
    "allow-export-diagnostics",
    "allow-set-device-placement",
    "allow-set-device-role",
    "allow-set-device-trim",
    "allow-set-distance-compensation",
    "allow-apply-sound-preset",
    "allow-set-device-map-placement",
    "allow-set-device-spread",
    "allow-set-device-subwoofer",
    "allow-set-spatial",
    "allow-set-device-eq",
    "allow-list-audio-apps",
    "allow-select-app-sources",
    "allow-list-microphones",
    "allow-calibrate",
    "updater:default",
    "process:allow-restart"
  ]
}
