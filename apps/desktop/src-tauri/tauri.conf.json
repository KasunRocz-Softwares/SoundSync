{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncSound",
  "version": "0.5.1",
  "identifier": "cloud.syncsound.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SyncSound",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "KR Softwares",
    "category": "Music",
    "shortDescription": "Play Windows audio on several speakers in sync",
    "longDescription": "SyncSound captures Windows audio and plays it on up to eight speakers, headphones and Bluetooth devices at once, with microphone calibration, a room map with 7.1 and 8D audio, per-app routing and per-speaker EQ.",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "copyright": "\u00a9 2026 KR Softwares",
    "homepage": "https://github.com/KasunRocz-Softwares/SoundSync",
    "license": "MIT",
    "licenseFile": "../../../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCM0ZBNkVGRDkxQjlFRTAKUldUZ25odlo3NlkvdS9nZk1TbVU0bW90aWRQYTZOUlRhZ0tRTXNhOU82dEcxeGZxbHZ2bm5XUzcK",
      "endpoints": [
        "https://github.com/KasunRocz-Softwares/SoundSync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
